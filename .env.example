# Run npm run setup to create local configuration and a one-time setup link.
APP_URL=http://localhost:3000
DATA_DIR=.data
# Public VPS address displayed in the admin DNS instructions.
VPS_PUBLIC_IP=
DATABASE_URL=
SESSION_SECRET=
SETUP_TOKEN=
RUN_WORKER=true
# Use vps for Hostinger with a persistent absolute DATA_DIR and separate media origin.
# Leave blank for AWS. The isolated free demo uses demo (never for client production).
DEPLOYMENT_MODE=
# Number of published releases to retain per portfolio; 0 keeps all. VPS setup uses 3.
RELEASE_RETENTION=0
# Original/extracted uploads per portfolio, including recoverable removed files.
# Raise only after budgeting published copies, backups and total VPS storage.
PORTFOLIO_MEDIA_LIMIT_MB=100
# Stop new VPS file writes before the shared disk fills (MB).
STORAGE_MIN_FREE_MB=2048
# Per web process; reject excess uploads before buffering them (1–4).
MAX_CONCURRENT_UPLOADS=2
# huggingface-browser runs a free local model in the admin's WebGPU browser.
# openai retains the paid, server-side background processing path.
# gemini uses Google AI Studio: free quotas for sample demos, or a paid project.
# Gemini runs on the server; supply your existing Google AI Studio Free-tier key.
AI_PROVIDER=gemini
# AWS uses its standard credential chain; do not embed AWS access keys in source.
AWS_REGION=ap-southeast-1
S3_BUCKET=
PUBLIC_BUCKET=
# Published assets must be served from a dedicated public media/CDN domain in production.
PUBLIC_ASSET_URL=
EMAIL_FROM=
# Resend Free: verify a sender domain and add a sending-only key. No paid fallback.
# Existing AWS deployments can explicitly use ses instead.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Production upload scanning: ClamAV INSTREAM TCP service, private network only.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLOUDFRONT_WAF_ARN=

# Optional override for local Word conversion; VPS image includes LibreOffice.
LIBREOFFICE_BIN=libreoffice

# Host-side domain reconciler only: copy to /etc/brilliancy-domains.env.
# Set the real public VPS IPv4 before enabling brilliancy-domains.timer.
BRILLIANCY_VPS_IP=
BRILLIANCY_ROOT=/opt/brilliancy
# Leave false until a reviewed pilot is explicitly approved for launch.
DOMAIN_GO_LIVE_ENABLED=false
# Host-side only, in /etc/brilliancy-domains.env (never in web containers):
# HOSTINGER_API_TOKEN_FILE=/etc/brilliancy-hostinger.token
# BRILLIANCY_GO_LIVE_DOMAINS=

# OFF-SERVER BACKUP HOST CONFIG ONLY. Put these in /etc/brilliancy-backup.env,
# not the application environment. See docs/BACKUPS_AND_CAPACITY.md.
# RESTIC_REPOSITORY=s3:https://YOUR-S3-ENDPOINT/YOUR-PRIVATE-BUCKET/brilliancy
# RESTIC_PASSWORD_FILE=/etc/brilliancy-backup.password
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
