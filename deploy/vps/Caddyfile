{
    email {$ACME_EMAIL}
    servers {
        timeouts {
            read_header 10s
            read_body 120s
            idle 60s
        }
    }
}

{$STUDIO_HOST} {
    encode zstd gzip
    request_body {
        max_size 22MB
    }
    # No access log: setup/invitation query strings carry one-time secrets.
    reverse_proxy web:3000 {
        header_up X-Brilliancy-IP {remote_host}
        transport http {
            dial_timeout 5s
            response_header_timeout 120s
        }
    }
}

{$MEDIA_HOST} {
    @releaseRead {
        method GET HEAD
        path /releases/*
    }
    handle @releaseRead {
        uri strip_prefix /releases
        root * /srv/data/storage/releases
        header X-Content-Type-Options nosniff
        header Content-Security-Policy "default-src 'none'; sandbox"
        header Cache-Control "public, max-age=31536000, immutable"
        @pdf path *.pdf
        header @pdf Content-Disposition attachment
        file_server
    }
    handle {
        respond "Not found." 404
    }
}

import /etc/caddy/domains/*.caddy
