{
    auto_https off
    servers {
        # Trust only the inspected EasyPanel overlay, not arbitrary private IPs.
        trusted_proxies static {$EASYPANEL_PROXY_CIDRS}
        trusted_proxies_strict
        client_ip_headers X-Forwarded-For
        timeouts {
            read_header 10s
            read_body 120s
            idle 60s
        }
    }
}

http://{$STUDIO_HOST}:8080 {
    encode zstd gzip
    request_body {
        max_size 22MB
    }
    reverse_proxy web:3000 {
        header_up X-Brilliancy-IP {client_ip}
        header_up X-Forwarded-Proto https
        transport http {
            dial_timeout 5s
            response_header_timeout 120s
        }
    }
}

http://{$MEDIA_HOST}:8080 {
    @read method GET HEAD
    handle @read {
        handle_path /releases/* {
            root * /srv/data/storage/releases
            header X-Content-Type-Options nosniff
            header Content-Security-Policy "default-src 'none'; sandbox"
            header Cache-Control "public, max-age=31536000, immutable"
            @pdf path *.pdf
            header @pdf Content-Disposition attachment
            file_server
        }
    }
    handle {
        respond "Not found." 404
    }
}

http://:8080 {
    respond "Not found." 404
}

import /etc/caddy/domains/*.caddy
