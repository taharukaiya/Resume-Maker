{
    auto_https off
    servers {
        timeouts {
            read_header 10s
            read_body 120s
            idle 60s
        }
    }
}

http://{$STUDIO_HOST}:8080 {
    encode zstd gzip
    request_body {
        max_size 22MB
    }
    # Only the host proxy may reach this listener. It must OVERWRITE
    # X-Brilliancy-IP with the actual client IP, never forward an input header.
    reverse_proxy web:3000 {
        header_up X-Brilliancy-IP {http.request.header.X-Brilliancy-IP}
        header_up X-Forwarded-Proto https
        transport http {
            dial_timeout 5s
            response_header_timeout 120s
        }
    }
}

http://{$MEDIA_HOST}:8080 {
    @releaseRead {
        method GET HEAD
        path /releases/*
    }
    handle @releaseRead {
        uri strip_prefix /releases
        root * /srv/data/storage/releases
        header X-Content-Type-Options nosniff
        header Content-Security-Policy "default-src 'none'; sandbox"
        header Cache-Control "public, max-age=31536000, immutable"
        @pdf path *.pdf
        header @pdf Content-Disposition attachment
        file_server
    }
    handle {
        respond "Not found." 404
    }
}

http://:8080 {
    respond "Not found." 404
}

import /etc/caddy/domains/*.caddy
